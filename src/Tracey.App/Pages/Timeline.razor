@page "/timeline"
@inject TauriIpcService Tauri
@inject TauriEventService Events
@inject IJSRuntime JS
@using Tracey.App.TimelineModel
@implements IAsyncDisposable

<PageTitle>Timeline — Tracey</PageTitle>

<div class="timeline-page" @ref="_page">
    @if (_errorMessage is not null)
    {
        <div role="alert" class="t-error-banner">
            <span>@_errorMessage</span>
            <button @onclick="DismissError" aria-label="Dismiss error">✕</button>
        </div>
    }

    <div class="timeline-header">
        <h1 class="page-title">Timeline</h1>
        <div class="timeline-controls">
            <input type="date"
                   @bind="_dateFilter"
                   @bind:after="LoadDay"
                   aria-label="Filter by date" />
            <button @onclick="RunCleanup" class="t-btn t-btn-ghost" aria-label="Clean up expired screenshots">
                Clean up
            </button>
        </div>
    </div>

    @if (_isLoading)
    {
        <div class="t-loading-text" aria-live="polite">Loading…</div>
    }
    else if (_day.IsEmpty)
    {
        <div class="empty-state-illustration" aria-label="No screenshots yet">
            <span class="empty-state-emoji">📅</span>
            <p class="empty-state-message">No screenshots for this day.</p>
            <p class="empty-state-hint">Screenshots are captured automatically while Tracey is running.</p>
        </div>
    }
    else
    {
        var daySpans = _day.VisibleSpans(ZoomRange.FullDay);
        var pinOffset = PinnedOffset();
        <div class="timeline-day-bar"
             aria-label="24-hour timeline for @_dateFilter.ToString("yyyy-MM-dd")">
            <div class="timeline-zoom-indicator" aria-live="polite">
                @* Its text is written by timeline-brush.js, so it follows a drag *@
                <span class="zoom-range-text" data-testid="zoom-range-text" data-zoom-text></span>
                @if (!_zoom.IsFullDay)
                {
                    <button class="zoom-reset-btn" @onclick="ResetZoom" title="Reset to full day view" aria-label="Reset zoom">↺ full day</button>
                }
            </div>
            <div class="timeline-bar-inner"
                 @onmousemove="HandleBarMouseMove"
                 @onmouseleave="ClearHover"
                 @onclick="HandleBarClick"
                 @onwheel="HandleBarWheel"
                 @onwheel:preventDefault="true"
                 @ondblclick="HandleBarDoubleClick">

                @* The whole day, shifted and stretched to the zoom range by CSS,
                   so it follows a drag on the overview without a render *@
                <div class="timeline-bar-day" aria-hidden="true">
                    @* Presence spans; Untracked draws nothing *@
                    @foreach (var span in daySpans)
                    {
                        <div class="timeline-span @SpanClass(span)"
                             style="left: @DayPercent(span.Start)%; width: @DayPercent(span.End - span.Start)%">
                        </div>
                    }

                    @{
                        var labelStep = _zoom.LabelStep;
                    }
                    @foreach (var t in _zoom.LabelTimes())
                    {
                        var label = ZoomRange.Clock(t);
                        <div class="timeline-hour-marker" style="left: @DayPercent(t)%; --label-step: @labelStep.TotalMinutes">
                            <span class="hour-label">@(labelStep < TimeSpan.FromHours(1) ? label : label[..2])</span>
                        </div>
                    }

                    @* Pin marker at the pinned capture's own time *@
                    @if (pinOffset is { } pinAt)
                    {
                        <div class="timeline-pin-line"
                             style="left: @DayPercent(pinAt)%"
                             data-testid="timeline-pin-line">
                        </div>
                    }
                </div>

                @if (_hoverOffset is { } hoverOffset)
                {
                    var hoverPct = CssPercent(_zoom.PercentOf(hoverOffset));
                    <div class="timeline-hover-line" style="left: @hoverPct%" aria-hidden="true"></div>
                    <span class="hover-time-label"
                          style="left: clamp(4.5rem, @hoverPct%, calc(100% - 4.5rem))"
                          aria-hidden="true">@ZoomRange.Clock(hoverOffset) · @_day.PresenceAt(_day.At(hoverOffset)).Word()</span>
                }
            </div>

            @* Overview: the whole day in miniature. timeline-brush.js handles the
               drag; the wheel zooms around the rectangle's centre. *@
            <div class="timeline-overview"
                 data-testid="timeline-overview"
                 aria-label="Whole day overview. The rectangle is the visible range: drag it to pan, drag an edge to resize."
                 @onwheel="HandleOverviewWheel"
                 @onwheel:preventDefault="true">
                @foreach (var span in daySpans)
                {
                    <div class="timeline-span @SpanClass(span)"
                         style="left: @DayPercent(span.Start)%; width: @DayPercent(span.End - span.Start)%"
                         aria-hidden="true">
                    </div>
                }
                @for (var hour = 0; hour < 24; hour += 3)
                {
                    <div class="overview-tick" style="left: @DayPercent(TimeSpan.FromHours(hour))%" aria-hidden="true">
                        @if (hour % 6 == 0)
                        {
                            <span>@hour.ToString("D2")</span>
                        }
                    </div>
                }
                <div class="overview-range" data-testid="overview-range" aria-hidden="true">
                    <div class="overview-grip overview-grip-left"></div>
                    <div class="overview-grip overview-grip-right"></div>
                </div>
                @if (pinOffset is { } pinTickAt)
                {
                    <div class="overview-pin-tick"
                         style="left: @DayPercent(pinTickAt)%"
                         data-testid="overview-pin-tick"
                         aria-hidden="true">
                    </div>
                }
            </div>
        </div>

        @* Preview area *@
        <div class="timeline-preview-area">
            @if (_selected is not null)
            {
                <div class="preview-header">
                    <span class="preview-time">@FormatTime(_selected.CapturedAt)</span>
                    <span class="preview-trigger" data-testid="trigger-badge">@FormatTrigger(_selected.Trigger)</span>
                    <span class="preview-process">@_selected.ProcessName</span>
                    <span class="preview-title preview-title-text">@_selected.WindowTitle</span>
                    <button @onclick="ClosePreview" class="preview-close" aria-label="Close preview">✕</button>
                </div>
                <img src="@_selectedImageUrl"
                     alt="Screenshot from @FormatTime(_selected.CapturedAt)"
                     class="screenshot-img"
                     @onerror="HandleImageError" />
            }
            else if (_hoverPick is HoverPick.Shot hoverShot)
            {
                <div class="preview-header preview-header-hover">
                    <span class="preview-time">@FormatTime(hoverShot.Screenshot.CapturedAt)</span>
                    <span class="preview-process">@hoverShot.Screenshot.ProcessName</span>
                    <span class="preview-title preview-title-text">@hoverShot.Screenshot.WindowTitle</span>
                </div>
                <img src="@_hoverImageUrl"
                     alt="Screenshot from @FormatTime(hoverShot.Screenshot.CapturedAt)"
                     class="screenshot-img screenshot-img-hover" />
            }
            else if (_hoverPick is HoverPick.Gap gap && _hoverOffset is { } gapOffset)
            {
                <div class="preview-placeholder preview-gap" data-testid="preview-gap">
                    <span>@PresenceText.GapCard(gap.Presence, ZoomRange.Clock(gapOffset))</span>
                </div>
            }
            else
            {
                <div class="preview-placeholder">
                    <span>Hover the bar to preview a screenshot</span>
                </div>
            }
        </div>

        @* Active window/title activity list *@
        <div class="activity-list-panel" data-testid="activity-list-panel">
            <button class="activity-list-header"
                    @onclick="ToggleActivity"
                    aria-expanded="@_activityExpanded"
                    aria-controls="activity-list-body">
                <span class="activity-list-title">🪟 Active Windows &amp; Titles</span>
                @* Written by timeline-brush.js; hidden at the full day *@
                <span class="activity-filter-badge" data-zoom-text></span>
                <span class="activity-list-count">@_visibleActivityEntries.Count @(_visibleActivityEntries.Count == 1 ? "entry" : "entries")</span>
                <span class="activity-list-chevron" aria-hidden="true">@(_activityExpanded ? "▲" : "▼")</span>
            </button>
            @if (_activityExpanded)
            {
                <div class="activity-list-body" id="activity-list-body" role="region"
                     aria-label="Active windows and titles">
                    @if (_visibleActivityEntries.Count == 0)
                    {
                        <div class="activity-list-empty">No activity data for this period.</div>
                    }
                    else
                    {
                        <div class="activity-table-wrapper">
                            <table class="activity-table" data-testid="activity-list">
                                <thead>
                                    <tr>
                                        <th scope="col">Process</th>
                                        <th scope="col">Title</th>
                                        <th scope="col">Start</th>
                                        <th scope="col">End</th>
                                    </tr>
                                </thead>
                                <tbody>
                                     @foreach (var entry in _visibleActivityEntries)
                                    {
                                        <tr class="act-row @(_selected?.Id == entry.Screenshot.Id ? "act-row-selected" : "")"
                                            @onclick="() => SelectScreenshot(entry.Screenshot)"
                                            role="button"
                                            tabindex="0"
                                            title="Show screenshot at @FormatActivityTime(entry.Start)"
                                            data-testid="activity-row">
                                            <td class="act-process" data-testid="process-name">@entry.ProcessName</td>
                                            <td class="act-title" data-testid="window-title">@entry.WindowTitle</td>
                                            <td class="act-time">@FormatActivityTime(entry.Start)</td>
                                            <td class="act-time">@(entry.End.HasValue ? FormatActivityTime(entry.End.Value) : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    // Matches the presence recorder's heartbeat (#120).
    private static readonly TimeSpan LiveTickInterval = TimeSpan.FromSeconds(30);

    private List<ScreenshotItem> _screenshots = new();
    private PresenceSpan[] _spans = [];
    private TimelineDay _day = TimelineDay.Create(DateOnly.FromDateTime(DateTime.Today), TimeZoneInfo.Local, [], []);
    private ScreenshotItem? _selected;
    private string _selectedImageUrl = string.Empty;
    private bool _isLoading;
    private string? _errorMessage;
    private DateOnly _dateFilter = DateOnly.FromDateTime(DateTime.Today);

    // Hover state
    private TimeSpan? _hoverOffset;
    private HoverPick? _hoverPick;
    private string? _hoverImageId;
    private string _hoverImageUrl = string.Empty;

    private ZoomRange _zoom = ZoomRange.FullDay;

    // Activity list state
    private bool _activityExpanded = true;
    private List<ActivityEntry> _allActivityEntries = new();
    private List<ActivityEntry> _visibleActivityEntries = new();

    // The overview brush (wwwroot/js/timeline-brush.js) is set up on the page root.
    private ElementReference _page;
    private DotNetObjectReference<Timeline>? _selfRef;

    // The pin before a double-click's first click, restored by the double-click.
    private ScreenshotItem? _pinBeforeClick;
    private string _pinImageBeforeClick = string.Empty;

    private Timer? _liveTick;

    // Only the latest request of each kind is applied, so a slow response never
    // overwrites a newer one or another date's.
    private int _screenshotsRequest;
    private int _spansRequest;

    // Bumped by a double-click, so a click still awaiting JS interop drops its pin.
    private int _clickGeneration;

    protected override async Task OnInitializedAsync()
    {
        Events.OnScreenshotCaptured += HandleScreenshotCaptured;
        Events.OnPresenceChanged += HandlePresenceChanged;
        Events.OnError += HandleError;
        await LoadDay();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("traceyTimeline.init", _page, _selfRef);
        }
        // Every render, so the brush's preview never outlives a commit.
        await JS.InvokeVoidAsync("traceyTimeline.setZoom", _page,
            _zoom.Start.TotalMinutes, _zoom.Length.TotalMinutes, _zoom.RangeText);
    }

    private Task LoadDay() => LoadDay(showLoading: true);

    private async Task LoadDay(bool showLoading)
    {
        if (showLoading)
        {
            _isLoading = true;
            _selected = null;
            _selectedImageUrl = string.Empty;
            ClearHover();
            StateHasChanged();
        }
        var date = _dateFilter;
        var screenshotsRequest = ++_screenshotsRequest;
        var spansRequest = ++_spansRequest;
        try
        {
            var bounds = TimelineDay.Create(date, TimeZoneInfo.Local, [], []);
            // screenshot_list's `to` is inclusive; presence_list's is not.
            var screenshots = Tauri.ScreenshotListAsync(
                bounds.DayStart.UtcDateTime.ToString("o"),
                bounds.DayEnd.UtcDateTime.AddTicks(-1).ToString("o"));
            var spans = FetchSpansAsync(date);
            await Task.WhenAll(screenshots, spans);
            if (screenshotsRequest != _screenshotsRequest) return;
            _screenshots = (screenshots.Result ?? Array.Empty<ScreenshotItem>()).ToList();
            if (spansRequest == _spansRequest) _spans = spans.Result;
            await BuildDayAsync(date);
            BuildActivityEntries();
        }
        catch (Exception ex)
        {
            if (screenshotsRequest == _screenshotsRequest)
                _errorMessage = $"Couldn't load the timeline: {ex.Message}";
        }
        finally
        {
            if (screenshotsRequest == _screenshotsRequest)
                _isLoading = false;
        }
    }

    private async Task<PresenceSpan[]> FetchSpansAsync(DateOnly date)
    {
        var bounds = TimelineDay.Create(date, TimeZoneInfo.Local, [], []);
        return await Tauri.PresenceListAsync(
            bounds.DayStart.UtcDateTime.ToString("o"),
            bounds.DayEnd.UtcDateTime.ToString("o")) ?? [];
    }

    private async Task BuildDayAsync(DateOnly date)
    {
        _day = TimelineDay.Create(date, TimeZoneInfo.Local, _spans, _screenshots).GrowOpenSpan(DateTimeOffset.Now);
        UpdateLiveTick();
        await RefreshHoverAsync();
    }

    // ── Live today (#120) ────────────────────────────────────────────────

    private void UpdateLiveTick()
    {
        var now = DateTimeOffset.Now;
        var isToday = now >= _day.DayStart && now < _day.DayEnd;
        if (!isToday)
            StopLiveTick();
        else
            _liveTick ??= new Timer(_ => InvokeAsync(LiveTickAsync), null, LiveTickInterval, LiveTickInterval);
    }

    private async Task LiveTickAsync()
    {
        // A render mid-drag would cost frames; the next tick catches up.
        if (await IsBrushingAsync()) return;
        var now = DateTimeOffset.Now;
        _day = _day.GrowOpenSpan(now);
        // Past midnight the page stays on its date: that was the last grow.
        if (now >= _day.DayEnd)
            StopLiveTick();
        await RefreshHoverAsync();
        StateHasChanged();
    }

    private async Task<bool> IsBrushingAsync()
    {
        try
        {
            return await JS.InvokeAsync<bool>("traceyTimeline.isBrushing");
        }
        catch (JSException)
        {
            // Without the brush module there is no drag to wait for.
            return false;
        }
    }

    private void StopLiveTick()
    {
        _liveTick?.Dispose();
        _liveTick = null;
    }

    private void HandlePresenceChanged(PresenceChangedPayload payload)
    {
        InvokeAsync(async () =>
        {
            var date = _dateFilter;
            var spansRequest = ++_spansRequest;
            try
            {
                var spans = await FetchSpansAsync(date);
                if (spansRequest != _spansRequest || date != _dateFilter) return;
                _spans = spans;
                await BuildDayAsync(date);
            }
            catch (Exception ex)
            {
                _errorMessage = $"Couldn't update the timeline bar: {ex.Message}";
            }
            StateHasChanged();
        });
    }

    private async Task RunCleanup()
    {
        try
        {
            await Tauri.ScreenshotDeleteExpiredAsync();
            _errorMessage = null;
            await LoadDay();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Cleanup failed: {ex.Message}";
        }
    }

    private async Task SelectScreenshot(ScreenshotItem s) =>
        await PinAsync(_selected?.Id == s.Id ? null : s);

    private async Task PinAsync(ScreenshotItem? s)
    {
        if (s?.Id == _selected?.Id) return;
        _selected = s;
        _selectedImageUrl = string.Empty;
        if (s is null) return;
        var url = await GetImgSrcAsync(s.FilePath);
        // The pin may have moved on while the URL was resolved.
        if (_selected?.Id == s.Id) _selectedImageUrl = url;
    }

    private void ClosePreview()
    {
        _selected = null;
        _selectedImageUrl = string.Empty;
    }

    private TimeSpan? PinnedOffset() =>
        _selected is not null && DateTimeOffset.TryParse(_selected.CapturedAt, out var at)
            ? _day.OffsetOf(at)
            : null;

    private void DismissError() => _errorMessage = null;

    private void HandleScreenshotCaptured(ScreenshotCapturedPayload payload)
    {
        // Auto-reload when a new screenshot is captured for today's date.
        // Use background refresh to avoid showing "Loading..." and clearing the selection.
        if (payload.CapturedAt.StartsWith(_dateFilter.ToString("yyyy-MM-dd"), StringComparison.OrdinalIgnoreCase)
            || DateOnly.FromDateTime(DateTime.Today) == _dateFilter)
        {
            InvokeAsync(async () =>
            {
                await LoadDay(showLoading: false);
                StateHasChanged();
            });
        }
    }

    private void HandleError(ErrorPayload payload)
    {
        _errorMessage = $"Screenshot error: {payload.Error}";
        InvokeAsync(StateHasChanged);
    }

    private void HandleImageError()
    {
        _errorMessage = "Could not load screenshot image — file may have been moved or deleted.";
    }

    // ── Bar mouse handling ───────────────────────────────────────────────

    private async Task HandleBarMouseMove(MouseEventArgs e)
    {
        _hoverOffset = await GetMouseOffsetAsync(e.ClientX);
        await RefreshHoverAsync();
    }

    /// Re-picks at the hovered time, also after the day changes under a still cursor.
    private async Task RefreshHoverAsync()
    {
        if (_hoverOffset is not { } offset) return;
        _hoverPick = _day.Pick(_day.At(offset));
        if (_hoverPick is HoverPick.Shot shot && shot.Screenshot.Id != _hoverImageId)
        {
            _hoverImageId = shot.Screenshot.Id;
            _hoverImageUrl = await GetImgSrcAsync(shot.Screenshot.FilePath);
        }
    }

    private void ClearHover()
    {
        _hoverOffset = null;
        _hoverPick = null;
        _hoverImageId = null;
        _hoverImageUrl = string.Empty;
    }

    private async Task HandleBarClick(MouseEventArgs e)
    {
        // A double-click's clicks arrive before it: the first one notes the pin
        // so the double-click can put it back, the second one is ignored.
        if (e.Detail > 1) return;
        _pinBeforeClick = _selected;
        _pinImageBeforeClick = _selectedImageUrl;

        var generation = _clickGeneration;
        var offset = await GetMouseOffsetAsync(e.ClientX);
        if (generation != _clickGeneration) return;
        await PinAsync(_day.PinAfterClick(_day.At(offset), _selected));
    }

    private void HandleBarDoubleClick()
    {
        // A double-click never pins, unpins or clears.
        _clickGeneration++;
        _selected = _pinBeforeClick;
        _selectedImageUrl = _pinImageBeforeClick;
        ResetZoom();
    }

    private async Task<TimeSpan> GetMouseOffsetAsync(double clientX) =>
        _zoom.OffsetAt(await GetMousePercentAsync(clientX));

    private async Task<double> GetMousePercentAsync(double clientX)
    {
        try
        {
            return await JS.InvokeAsync<double>("traceyBridge.getTimelineBarPercent", clientX);
        }
        catch
        {
            return 0;
        }
    }

    private async Task<string> GetImgSrcAsync(string filePath)
    {
        try
        {
            return await JS.InvokeAsync<string>("traceyBridge.convertFileSrc", filePath);
        }
        catch
        {
            // Fallback manual conversion
            var normalized = filePath.Replace('\\', '/').TrimStart('/');
            if (normalized.Length > 1 && normalized[1] == ':')
                normalized = normalized[0] + "%3A" + normalized[2..];
            return $"https://asset.localhost/{normalized}";
        }
    }

    private static string CssPercent(double percent) =>
        percent.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);

    /// Where <paramref name="offset"/> falls in the whole day, 0–100. Four
    /// decimals, since the main bar stretches the day up to 96× at 15 min.
    private static string DayPercent(TimeSpan offset) =>
        (offset / ZoomRange.MaxLength * 100.0).ToString("F4", System.Globalization.CultureInfo.InvariantCulture);

    private static string SpanClass(VisibleSpan span) =>
        span.Presence == Presence.Present ? "timeline-span-present" : "timeline-span-away";

    private static string FormatTime(string utcIso)
    {
        if (DateTimeOffset.TryParse(utcIso, out var dto))
            return dto.LocalDateTime.ToString("HH:mm:ss");
        return utcIso;
    }

    // Keep in sync with the Rust `Trigger` enum (src-tauri/src/models/mod.rs), the source of truth.
    private static string FormatTrigger(string trigger) => trigger switch
    {
        "interval"       => "⏱ Interval",
        "window_change"  => "🔄 Window change",
        "suspension_end" => "▶ Resumed",
        _                => trigger
    };

    // ── Zoom ─────────────────────────────────────────────────────────────

    private async Task HandleBarWheel(WheelEventArgs e)
    {
        // DeltaY > 0 = scroll down = zoom out; DeltaY < 0 = scroll up = zoom in
        if (e.DeltaY == 0) return;
        var anchor = await GetMouseOffsetAsync(e.ClientX);
        var zoomed = e.DeltaY > 0 ? _zoom.ZoomOut(anchor) : _zoom.ZoomIn(anchor);
        if (zoomed == _zoom) return;

        _zoom = zoomed;
        RefreshVisibleEntries();
        StateHasChanged();
    }

    private void HandleOverviewWheel(WheelEventArgs e)
    {
        if (e.DeltaY == 0) return;
        var zoomed = e.DeltaY > 0 ? _zoom.ZoomOut(_zoom.Centre) : _zoom.ZoomIn(_zoom.Centre);
        if (zoomed == _zoom) return;

        _zoom = zoomed;
        RefreshVisibleEntries();
    }

    /// The one call from timeline-brush.js per overview drag: a press at
    /// <paramref name="fromPx"/>, released at <paramref name="toPx"/>, on an
    /// overview <paramref name="widthPx"/> wide, starting from the range shown
    /// at the press (in minutes). ZoomRange re-applies its limits and decides.
    [JSInvokable]
    public void CommitBrush(double startMinutes, double lengthMinutes, double widthPx, double fromPx, double toPx)
    {
        if (widthPx > 0)
        {
            var pressed = ZoomRange.Create(TimeSpan.FromMinutes(startMinutes), TimeSpan.FromMinutes(lengthMinutes));
            _zoom = pressed.Brush(widthPx, fromPx, toPx);
            RefreshVisibleEntries();
        }
        // Always render, so setZoom replaces the drag's preview.
        StateHasChanged();
    }

    private void ResetZoom()
    {
        _zoom = ZoomRange.FullDay;
        RefreshVisibleEntries();
        StateHasChanged();
    }

    // ── Activity list ────────────────────────────────────────────────────

    private void ToggleActivity() => _activityExpanded = !_activityExpanded;

    private void BuildActivityEntries()
    {
        if (_screenshots.Count == 0)
        {
            _allActivityEntries = new();
            _visibleActivityEntries = new();
            return;
        }

        var sorted = _screenshots
            .Select(s => (s, dto: DateTimeOffset.TryParse(s.CapturedAt, out var d) ? d : (DateTimeOffset?)null))
            .Where(x => x.dto.HasValue)
            .OrderBy(x => x.dto!.Value)
            .ToList();

        var entries = new List<ActivityEntry>();
        int i = 0;
        while (i < sorted.Count)
        {
            var (s, startDto) = sorted[i];
            int j = i + 1;
            while (j < sorted.Count &&
                   sorted[j].s.ProcessName == s.ProcessName &&
                   sorted[j].s.WindowTitle == s.WindowTitle)
            {
                j++;
            }
            var endDto = j < sorted.Count ? sorted[j].dto : (DateTimeOffset?)null;
            entries.Add(new ActivityEntry(s.ProcessName, s.WindowTitle, startDto!.Value, endDto, s));
            i = j;
        }
        _allActivityEntries = entries;
        RefreshVisibleEntries();
    }

    private void RefreshVisibleEntries()
    {
        if (_zoom.IsFullDay)
        {
            _visibleActivityEntries = _allActivityEntries;
            return;
        }

        var viewStart = _day.At(_zoom.Start);
        var viewEnd = _day.At(_zoom.End);

        _visibleActivityEntries = _allActivityEntries.Where(e =>
        {
            var entryEnd = e.End ?? DateTimeOffset.MaxValue;
            return e.Start < viewEnd && entryEnd > viewStart;
        }).ToList();
    }

    private static string FormatActivityTime(DateTimeOffset dto) =>
        dto.LocalDateTime.ToString("HH:mm:ss");

    private record ActivityEntry(
        string ProcessName,
        string WindowTitle,
        DateTimeOffset Start,
        DateTimeOffset? End,
        ScreenshotItem Screenshot);

    public async ValueTask DisposeAsync()
    {
        StopLiveTick();
        Events.OnScreenshotCaptured -= HandleScreenshotCaptured;
        Events.OnPresenceChanged -= HandlePresenceChanged;
        Events.OnError -= HandleError;
        if (_selfRef is not null)
        {
            await JS.InvokeVoidAsync("traceyTimeline.dispose", _page);
            _selfRef.Dispose();
        }
    }
}
